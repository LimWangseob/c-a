@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ==================================================
echo    정산 자동 다운로드 - 지금 수동 실행
echo ==================================================
echo.
echo  * 이 PC가 '사무실'일 때 실행하세요.
echo    (로그인 2차인증이 위치 기반이라 사무실에서만 자동으로 통과됩니다.)
echo  * 계정마다 크롬 창이 떴다 닫힙니다. 2차인증/캡차가 나오면 직접 처리하세요.
echo  * 18:00 야간 자동 실행과 겹치지 않게 17:40 에 멈춥니다(남은 분량은 다음 실행에서 이어감).
echo.
if not exist "data\정산_계정목록.txt" (
  echo  [중단] data\정산_계정목록.txt 가 없습니다.
  echo         한 줄 = "계정ID  비번  대표자-사업자" 형식으로 이 폴더의 data 안에 넣으세요.
  echo         ^(비밀번호가 평문이라 배포 파일엔 없습니다 - 이 PC 에 직접 둡니다.^)
  echo.
  pause
  exit /b 1
)
if not exist "정산다운로드.exe" (
  echo  [중단] 정산다운로드.exe 가 이 폴더에 없습니다. 배포본을 이 폴더에 풀었는지 확인하세요.
  echo.
  pause
  exit /b 1
)
echo  시작할까요? 계속하려면 아무 키나 누르세요(취소는 이 창을 닫으세요).
pause >nul
start "" "%~dp0정산다운로드.exe" run --until 17:40
echo.
echo  실행을 시작했습니다. 이 창은 닫아도 됩니다.
echo  진행 상황은 '정산_상태확인.bat' 더블클릭, 또는 output\정산\로그\ 폴더에서 확인하세요.
echo.
pause
