@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ==================================================
echo    정산 증빙 원본 전체 받기 (전 위탁계정 - D-067)
echo ==================================================
echo.
echo  받는 곳 : output\정산\증빙\증빙_{사업자}_쿠팡원본\
echo  기간    : 2026-01-01 ~ 오늘
echo  멈춤    : 17:30 이후엔 새 계정을 시작하지 않음(18:00 야간 실행과 겹치지 않게)
echo  이어받기: 끝난 계정(_수집완료.json)은 건너뜀 - 다시 더블클릭하면 남은 계정부터
echo.
echo  * 계정 하나에 약 1~1.5시간(쿠팡 리포트 요청 간격 45~75초). 창을 닫지 마세요.
echo  * 로그인은 앱과 같은 방식(계정 파일 비밀번호 자동 입력, 2차인증은 사람).
echo.
if not exist "정산다운로드.exe" (
  echo  [오류] 정산다운로드.exe 가 이 폴더에 없습니다. coupang-analytics 폴더에서 실행하세요.
  pause
  exit /b 1
)
"정산다운로드.exe" evidence --out "%~dp0output\정산\증빙" --from 2026-01-01 --until 17:30
echo.
echo ==================================================
echo  결과: 계정 폴더마다 _수집결과.json(단계별 정상/실패) · _증빙목록.csv(파일 목록)
echo  상세 기록: output\정산\로그\처리기록_누적.csv
echo ==================================================
pause
